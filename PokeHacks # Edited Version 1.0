// ==UserScript==
// @name        PokeClicker Hacks (Modal + Right Selector Fix)
// @author      fiammanda #edited by cKY
// @version     3.3
// @grant       none
// @match       https://www.pokeclicker.com/
// @license     MIT
// @description Clean 2-section hack modal with working Auto Clicker for PokeClicker
// @namespace   https://greasyfork.org/users/1055144
// ==/UserScript==

(function() {
    'use strict';

    function initHackModal() {
        window.clickHackInterval = window.clickHackInterval || null;
        window.hatchHackInterval = window.hatchHackInterval || null;

        const defaultCatchTimes = [1250, 1000, 750, 500];

        const hacks = [
            [0, "catch rate"],
            ["shiny", "shiny chance"],
            ["roaming", "roaming chance"],
            ["exp", "experience"],
            ["eggStep", "egg step"],
            ["money", "money"],
            ["dungeonToken", "dungeon token"],
            ["clickAttack", "player attack"],
            ["pokemonAttack", "pokemon attack"],
            [4, "berry growth"],
            [8, "berry mutation"],
            [9, "berry replant"],
            [7, "mine energy"],
            [10, "mine damage"],
            [11, "mine award"]
        ];

        const multiplierOptions = [2, 4, 8, 16, 32, 64, 128, 256, 512];

        const style = document.createElement("style");
        style.innerHTML = `
            #hackModal .modal-dialog {
                max-width: 600px !important;
                width: 600px !important;
            }
            #hack {
                font-size: .825rem;
                overflow: auto;
            }
            #hack img, #hack svg {
                width: 1.25rem;
                height: 1.25rem;
                vertical-align: middle;
                color: #222;
            }
            #hack table {
                table-layout: fixed !important;
                width: 100% !important;
                text-align: center;
            }
            #hack td {
                padding: .35rem .2rem;
                vertical-align: middle !important;
            }
            #hack td.section-header {
                background-color: #e9ecef;
                font-weight: bold;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                font-size: 0.75rem;
                color: #495057;
                text-align: left !important;
                padding-left: .75rem !important;
            }
            #hack td.disabled {
                background: rgba(0,0,0,.03);
                pointer-events: none;
            }
            #hack td.disabled img, #hack td.disabled svg {
                opacity: .25;
            }
            #hack td:first-child {
                padding-left: .5rem;
                text-align: left;
                font-weight: 500;
                text-transform: capitalize;
            }
            #hack td[onclick] {
                background: rgba(0,0,0,.05);
                transition: background .2s ease-in-out;
                cursor: pointer;
            }
            #hack td[onclick]:hover {
                background: rgba(0,0,0,.12);
            }
            .hack-select {
                font-size: 0.75rem;
                font-weight: 600;
                padding: 3px 2px;
                border-radius: 4px;
                border: 1px solid rgba(0,0,0,.15);
                background-color: rgba(0,0,0,.04);
                color: #333;
                cursor: pointer;
                outline: none;
                transition: all .2s ease-in-out;
                width: 100%;
                text-align: center;
                text-align-last: center;
            }
            .hack-select:hover {
                background-color: rgba(0,0,0,.08);
            }
            .hack-select.active-rate {
                background-color: rgba(40, 167, 69, 0.25) !important;
                border-color: #28a745 !important;
                color: #155724 !important;
            }
            .active-catch {
                background: rgba(40, 167, 69, 0.3) !important;
            }
        `;
        document.body.append(style);

        const openBtnContainer = document.createElement("div");
        openBtnContainer.className = "mb-3";
        openBtnContainer.innerHTML = `<button class="btn btn-block btn-danger" data-toggle="modal" data-target="#hackModal">Hacks</button>`;

        const modalContainer = document.createElement("div");
        modalContainer.className = "modal fade";
        modalContainer.id = "hackModal";
        modalContainer.setAttribute("tabindex", "-1");
        modalContainer.setAttribute("role", "dialog");
        modalContainer.setAttribute("aria-hidden", "true");

        const balls = [
            { name: 'Pokeball', img: 'assets/images/pokeball/Pokeball.svg' },
            { name: 'Greatball', img: 'assets/images/pokeball/Greatball.svg' },
            { name: 'Ultraball', img: 'assets/images/pokeball/Ultraball.svg' },
            { name: 'Masterball', img: 'assets/images/pokeball/Masterball.svg' }
        ];

        let html = `
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-secondary">
                <div class="modal-header bg-danger text-white p-2 align-items-center">
                    <h5 class="modal-title m-0">PokeClicker Hacks</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div id="hack" class="modal-body p-0">
                    <table class="table table-bordered m-0">
                        <colgroup>
                            <col style="width: 50%;">
                            <col style="width: 10%;">
                            <col style="width: 10%;">
                            <col style="width: 15%;">
                            <col style="width: 15%;">
                        </colgroup>

                        <!-- SECTION 1: MULTIPLIERS -->
                        <tr>
                            <td colspan="5" class="section-header">Multipliers</td>
                        </tr>`;

        hacks.forEach((h, i) => {
            html += `<tr><td>${h[1]}</td>`;

            // Column 2: Add Button (+)
            html += `<td id="hack-btn-add-${i}" onclick="`;
            html += `let selectElem = document.getElementById('hack-select-${i}');`;
            html += `let currentRate = Number(selectElem.value);`;
            html += `let newRate = currentRate === 0 ? 2 : currentRate * 2;`;
            html += `if (newRate > 512) newRate = 512;`;
            html += `window.applyHackRate(${i}, newRate);`;
            html += `"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 5.75V18.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 12"/></svg></td>`;

            // Column 3: Reset Button
            html += `<td id="hack-btn-sub-${i}" class="disabled" onclick="window.applyHackRate(${i}, 0);">`;
            html += `<svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 4.75L8.75 7L11.25 9.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12.75 19.25L15.25 17L12.75 14.75"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 7H13.25C16.5637 7 19.25 9.68629 19.25 13V13.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.25 17H10.75C7.43629 17 4.75 14.3137 4.75 11V10.75"/></svg></td>`;

            // Column 4 & 5 (Merged): Dropdown select with DEFAULT
            html += `<td colspan="2"><select id="hack-select-${i}" class="hack-select" onchange="window.applyHackRate(${i}, Number(this.value));">`;
            html += `<option value="0">DEFAULT</option>`;
            multiplierOptions.forEach(opt => {
                html += `<option value="${opt}">x${opt}</option>`;
            });
            html += `</select></td></tr>`;
        });

        html += `
                        <!-- SECTION 2: AUTOMATION & TOGGLES -->
                        <tr>
                            <td colspan="5" class="section-header">Automation & Toggles</td>
                        </tr>
                        <tr>
                            <td>instant catch</td>`;

        // 4 Pokeball icons in the remaining 4 columns
        balls.forEach((b, idx) => {
            html += `
                <td id="pokeball-btn-${idx}" onclick="
                    if (this.classList.contains('active-catch')) {
                        this.classList.remove('active-catch');
                        App.game.pokeballs.pokeballs[${idx}].catchTime = ${defaultCatchTimes[idx]};
                        localStorage.removeItem('poke_catch_time_${idx}');
                    } else {
                        this.classList.add('active-catch');
                        App.game.pokeballs.pokeballs[${idx}].catchTime = 100;
                        localStorage.setItem('poke_catch_time_${idx}', '1');
                    }
                "><img src="${b.img}" title="${b.name}"></td>`;
        });

        html += `
                        </tr>
                        <tr>
                            <td colspan="3">auto click</td>
                            <td id="autoclick-start" onclick="
                                this.classList.add('disabled');
                                document.getElementById('autoclick-stop').classList.remove('disabled');
                                window.clickHackInterval = setInterval(() => {
                                    if (App.game.gameState === GameConstants.GameState.fighting) {
                                        Battle.clickAttack();
                                    } else if (App.game.gameState === GameConstants.GameState.dungeon) {
                                        DungeonRunner.handleClick();
                                    }
                                }, 50);
                                localStorage.setItem('poke_autoclick', '1');
                            "><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 5.75V18.25L18.25 12Z"/></svg></td>
                            <td id="autoclick-stop" class="disabled" onclick="
                                this.classList.add('disabled');
                                document.getElementById('autoclick-start').classList.remove('disabled');
                                clearInterval(window.clickHackInterval);
                                localStorage.removeItem('poke_autoclick');
                            "><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.25 6.75V17.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.75 6.75V17.25"/></svg></td>
                        </tr>
                        <tr>
                            <td colspan="3">auto hatch</td>
                            <td id="autohatch-start" onclick="this.classList.add('disabled');document.getElementById('autohatch-stop').classList.remove('disabled');window.hatchHackInterval=setInterval(function(){for(let a=App.game.party.caughtPokemon.filter(a=>!(a.breeding||100>a.level)&&!(-1<BreedingController.filter.category()&&a.category!=BreedingController.filter.category())&&!(-1<BreedingController.filter.shinyStatus()&&+a.shiny!==BreedingController.filter.shinyStatus()));App.game.breeding.hasFreeQueueSlot()&&a.length;)App.game.breeding.addPokemonToHatchery(a[0]),a.shift()},6e4);localStorage.setItem('poke_autohatch', '1');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 5.75V18.25L18.25 12Z"/></svg></td>
                            <td id="autohatch-stop" class="disabled" onclick="this.classList.add('disabled');document.getElementById('autohatch-start').classList.remove('disabled');clearInterval(window.hatchHackInterval);localStorage.removeItem('poke_autohatch');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.25 6.75V17.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.75 6.75V17.25"/></svg></td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer p-2 text-right bg-light" style="font-size: 0.75rem; color: #6c757d;">
                    edited by cKy
                </div>
            </div>
        </div>`;

        modalContainer.innerHTML = html;
        document.body.appendChild(modalContainer);

        window.applyHackRate = function(i, rate) {
            const h = hacks[i];
            const subBtn = document.getElementById(`hack-btn-sub-${i}`);
            const selectElem = document.getElementById(`hack-select-${i}`);

            if (selectElem) {
                selectElem.value = multiplierOptions.includes(rate) ? rate : "0";
                if (rate > 0) {
                    selectElem.classList.add('active-rate');
                } else {
                    selectElem.classList.remove('active-rate');
                }
            }

            if (rate > 0) {
                subBtn.classList.remove('disabled');
                if (i == 0 || i > 8) {
                    App.game.oakItems.itemList[h[0]].bonusList = [rate, rate, rate, rate, rate, rate];
                    App.game.oakItems.itemList[h[0]].inactiveBonus = rate;
                } else {
                    App.game.multiplier.addBonus(h[0], () => rate);
                }
                localStorage.setItem(`poke_hack_rate_${i}`, rate);
            } else {
                subBtn.classList.add('disabled');
                if (i == 0 || i > 8) {
                    App.game.oakItems.itemList[h[0]].bonusList = [1, 1, 1, 1, 1, 1];
                    App.game.oakItems.itemList[h[0]].inactiveBonus = 1;
                } else {
                    App.game.multiplier.addBonus(h[0], () => 1);
                }
                localStorage.removeItem(`poke_hack_rate_${i}`);
            }
        };

        const checkInterval = setInterval(() => {
            const leftColumn = document.querySelector(".justify-content-lg-center .col-lg-3:first-child");
            if (leftColumn && typeof App !== 'undefined' && App.game) {
                clearInterval(checkInterval);
                leftColumn.prepend(openBtnContainer);
                restoreSettings();
            }
        }, 500);

        function restoreSettings() {
            for (let idx = 0; idx < 4; idx++) {
                if (localStorage.getItem(`poke_catch_time_${idx}`) === '1') {
                    const btn = document.getElementById(`pokeball-btn-${idx}`);
                    if (btn && !btn.classList.contains('active-catch')) btn.click();
                }
            }

            hacks.forEach((h, i) => {
                const savedRate = parseInt(localStorage.getItem(`poke_hack_rate_${i}`));
                if (savedRate && savedRate > 0) {
                    window.applyHackRate(i, savedRate);
                }
            });

            if (localStorage.getItem('poke_autoclick') === '1') {
                const btn = document.getElementById('autoclick-start');
                if (btn) btn.click();
            }

            if (localStorage.getItem('poke_autohatch') === '1') {
                const btn = document.getElementById('autohatch-start');
                if (btn) btn.click();
            }
        }
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
        initHackModal();
    } else {
        window.addEventListener("DOMContentLoaded", initHackModal);
    }
})();
