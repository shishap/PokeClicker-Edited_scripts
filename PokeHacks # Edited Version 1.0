// ==UserScript==
// @name        PokeClicker Hacks (Modal + AutoSave + Layout Fix)
// @author      fiammanda #edited by cKY
// @version     1.0
// @grant       none
// @match       https://www.pokeclicker.com/
// @license     MIT
// @description Modal hack menu for PokeClicker with alignment fixes and full Pokéball controls
// @namespace   https://greasyfork.org/users/1055144
// ==/UserScript==

(function() {
    'use strict';

    function initHackModal() {
        window.clickHackInterval = window.clickHackInterval || null;
        window.hatchHackInterval = window.hatchHackInterval || null;

        const defaultCatchTimes = [1250, 1000, 750, 500]; // Pokéball, Greatball, Ultraball, Masterball

        const hacks = [
            [0, "catch rate", 2],
            ["shiny", "shiny chance", 2],
            ["roaming", "roaming chance", 2],
            ["exp", "experience", 2],
            ["eggStep", "egg step", 2],
            ["money", "money", 2],
            ["dungeonToken", "dungeon token", 2],
            ["clickAttack", "player attack", 2],
            ["pokemonAttack", "pokemon attack", 2],
            [4, "berry growth", 2],
            [8, "berry mutation", 2],
            [9, "berry replant", 2],
            [7, "mine enery", 2],
            [10, "mine damage", 2],
            [11, "mine award", 2]
        ];

        const style = document.createElement("style");
        style.innerHTML = `
            #hackModal .modal-dialog {
                max-width: 500px;
            }
            #hack {
                font-size: .825rem;
                overflow: auto;
            }
            #hack img, #hack svg {
                width: 1.25rem;
                height: 1.25rem;
                vertical-align: middle;
                color: #222;
            }
            #hack table {
                table-layout: fixed;
                width: 100%;
                text-align: center;
            }
            #hack td {
                padding: .4rem .2rem;
                vertical-align: middle !important;
            }
            #hack td.disabled {
                background: rgba(0,0,0,.03);
                pointer-events: none;
            }
            #hack td.disabled img, #hack td.disabled svg {
                opacity: .25;
            }
            #hack td:first-child {
                padding-left: .5rem;
                text-align: left;
                font-weight: 500;
            }
            #hack td[data-rate]::before {
                content: attr(data-rate);
                font-size: .8rem;
                white-space: nowrap;
                font-weight: bold;
            }
            #hack td[data-rate="0"]::before {
                content: "-";
                font-weight: normal;
            }
            #hack td[onclick] {
                width: 2.2rem;
                background: rgba(0,0,0,.05);
                transition: background .2s ease-in-out;
                cursor: pointer;
            }
            #hack td[onclick]:hover {
                background: rgba(0,0,0,.12);
            }
            .active-catch {
                background: rgba(40, 167, 69, 0.3) !important;
            }
        `;
        document.body.append(style);

        const openBtnContainer = document.createElement("div");
        openBtnContainer.className = "mb-3";
        openBtnContainer.innerHTML = `<button class="btn btn-block btn-danger" data-toggle="modal" data-target="#hackModal">Hacks</button>`;

        const modalContainer = document.createElement("div");
        modalContainer.className = "modal fade";
        modalContainer.id = "hackModal";
        modalContainer.setAttribute("tabindex", "-1");
        modalContainer.setAttribute("role", "dialog");
        modalContainer.setAttribute("aria-hidden", "true");

        const balls = [
            { name: 'Pokeball', img: 'assets/images/pokeball/Pokeball.svg' },
            { name: 'Greatball', img: 'assets/images/pokeball/Greatball.svg' },
            { name: 'Ultraball', img: 'assets/images/pokeball/Ultraball.svg' },
            { name: 'Masterball', img: 'assets/images/pokeball/Masterball.svg' }
        ];

        let html = `
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-secondary">
                <div class="modal-header bg-danger text-white p-2 align-items-center">
                    <h5 class="modal-title m-0">PokeClicker Hacks</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div id="hack" class="modal-body p-0">
                    <table class="table table-bordered m-0">
                        <tr>
                            <td>catch time</td>`;

        balls.forEach((b, idx) => {
            html += `
                <td id="pokeball-btn-${idx}" onclick="
                    if (this.classList.contains('active-catch')) {
                        this.classList.remove('active-catch');
                        App.game.pokeballs.pokeballs[${idx}].catchTime = ${defaultCatchTimes[idx]};
                        localStorage.removeItem('poke_catch_time_${idx}');
                    } else {
                        this.classList.add('active-catch');
                        App.game.pokeballs.pokeballs[${idx}].catchTime = 100;
                        localStorage.setItem('poke_catch_time_${idx}', '1');
                    }
                "><img src="${b.img}" title="${b.name}"></td>`;
        });

        html += `</tr>`;

        hacks.forEach((h, i) => {
            html += `<tr><td colspan="2">${h[1]}</td><td id="hack-rate-${i}" data-rate="0"></td><td id="hack-btn-add-${i}" onclick="`;
            html += `let currentRate = Number(this.previousSibling.dataset.rate);`;
            html += `let newRate = currentRate === 0 ? 2 : currentRate * 2;`;
            html += `this.previousSibling.dataset.rate = newRate;`;
            html += `document.getElementById('hack-btn-sub-${i}').classList.remove('disabled');`;
            if (i == 0 || i > 8) {
                html += `App.game.oakItems.itemList[${h[0]}].bonusList = [newRate,newRate,newRate,newRate,newRate,newRate];`;
                html += `App.game.oakItems.itemList[${h[0]}].inactiveBonus = newRate;`;
            } else {
                html += `App.game.multiplier.addBonus('${h[0]}', () => newRate);`;
            }
            html += `localStorage.setItem('poke_hack_rate_${i}', newRate);`;
            html += `"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 5.75V18.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 12"/></svg></td><td id="hack-btn-sub-${i}" class="disabled" onclick="`;
            if (i == 0 || i > 8) {
                html += `App.game.oakItems.itemList[${h[0]}].bonusList = [1,1,1,1,1,1];`;
                html += `App.game.oakItems.itemList[${h[0]}].inactiveBonus = 1;`;
            } else {
                html += `App.game.multiplier.addBonus('${h[0]}', () => 1);`;
            }
            html += `document.getElementById('hack-rate-${i}').dataset.rate = 0;`;
            html += `this.classList.add('disabled');`;
            html += `localStorage.removeItem('poke_hack_rate_${i}');`;
            html += `"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.25 4.75L8.75 7L11.25 9.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12.75 19.25L15.25 17L12.75 14.75"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 7H13.25C16.5637 7 19.25 9.68629 19.25 13V13.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.25 17H10.75C7.43629 17 4.75 14.3137 4.75 11V10.75"/></svg></td></tr>`;
        });

        html += `
                        <tr>
                            <td colspan="3">auto click</td>
                            <td id="autoclick-start" onclick="this.classList.add('disabled');document.getElementById('autoclick-stop').classList.remove('disabled');window.clickHackInterval=setInterval(()=>{4==App.game.gameState&&DungeonRunner.handleClick()},100);localStorage.setItem('poke_autoclick', '1');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 5.75V18.25L18.25 12Z"/></svg></td>
                            <td id="autoclick-stop" class="disabled" onclick="this.classList.add('disabled');document.getElementById('autoclick-start').classList.remove('disabled');clearInterval(window.clickHackInterval);localStorage.removeItem('poke_autoclick');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.25 6.75V17.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.75 6.75V17.25"/></svg></td>
                        </tr>
                        <tr>
                            <td colspan="3">auto hatch</td>
                            <td id="autohatch-start" onclick="this.classList.add('disabled');document.getElementById('autohatch-stop').classList.remove('disabled');window.hatchHackInterval=setInterval(function(){for(let a=App.game.party.caughtPokemon.filter(a=>!(a.breeding||100>a.level)&&!(-1<BreedingController.filter.category()&&a.category!=BreedingController.filter.category())&&!(-1<BreedingController.filter.shinyStatus()&&+a.shiny!==BreedingController.filter.shinyStatus()));App.game.breeding.hasFreeQueueSlot()&&a.length;)App.game.breeding.addPokemonToHatchery(a[0]),a.shift()},6e4);localStorage.setItem('poke_autohatch', '1');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.25 12L5.75 5.75V18.25L18.25 12Z"/></svg></td>
                            <td id="autohatch-stop" class="disabled" onclick="this.classList.add('disabled');document.getElementById('autohatch-start').classList.remove('disabled');clearInterval(window.hatchHackInterval);localStorage.removeItem('poke_autohatch');"><svg fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.25 6.75V17.25"/><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.75 6.75V17.25"/></svg></td>
                        </tr>
                    </table>
                </div>
                <div class="modal-footer p-2 text-right bg-light" style="font-size: 0.75rem; color: #6c757d;">
                    edited by cKy
                </div>
            </div>
        </div>`;

        modalContainer.innerHTML = html;
        document.body.appendChild(modalContainer);

        const checkInterval = setInterval(() => {
            const leftColumn = document.querySelector(".justify-content-lg-center .col-lg-3:first-child");
            if (leftColumn && typeof App !== 'undefined' && App.game) {
                clearInterval(checkInterval);
                leftColumn.prepend(openBtnContainer);
                restoreSettings();
            }
        }, 500);

        function restoreSettings() {
            for (let idx = 0; idx < 4; idx++) {
                if (localStorage.getItem(`poke_catch_time_${idx}`) === '1') {
                    const btn = document.getElementById(`pokeball-btn-${idx}`);
                    if (btn && !btn.classList.contains('active-catch')) btn.click();
                }
            }

            hacks.forEach((h, i) => {
                const savedRate = parseInt(localStorage.getItem(`poke_hack_rate_${i}`));
                if (savedRate && savedRate > 0) {
                    const btn = document.getElementById(`hack-btn-add-${i}`);
                    if (btn) {
                        let current = 1;
                        while (current < savedRate) {
                            btn.click();
                            current *= 2;
                        }
                    }
                }
            });

            if (localStorage.getItem('poke_autoclick') === '1') {
                const btn = document.getElementById('autoclick-start');
                if (btn) btn.click();
            }

            if (localStorage.getItem('poke_autohatch') === '1') {
                const btn = document.getElementById('autohatch-start');
                if (btn) btn.click();
            }
        }
    }

    if (document.readyState === "complete" || document.readyState === "interactive") {
        initHackModal();
    } else {
        window.addEventListener("DOMContentLoaded", initHackModal);
    }
})();
